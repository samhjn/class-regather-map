# Copy values into your process environment or use Docker Compose's env_file.
# manage.py deliberately does not automatically load .env files.
DEBUG=0
SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
ALLOWED_HOSTS=class.example.com
CSRF_TRUSTED_ORIGINS=https://class.example.com
DEFAULT_CLASS_SLUG=our-class
TRUST_PROXY=1
SECURE_SSL_REDIRECT=1

MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=regather
MYSQL_USER=regather
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
# MYSQL_SSL_CA=/run/secrets/mysql-ca.pem

# Web端 (JS API) Key, restricted to your domain in the AMap console.
AMAP_JS_KEY=
AMAP_SERVICE_HOST=/_AMapService
# FC: enable the built-in same-origin proxy and keep securityJsCode server-side.
AMAP_PROXY_ENABLED=0
AMAP_PROXY_SECURITY_CODE=
# With nginx, leave the built-in proxy disabled and configure its upstream there.
# Development only: AMAP_SECURITY_JS_CODE=...
